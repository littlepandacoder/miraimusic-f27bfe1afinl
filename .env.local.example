# Firebase Configuration for Musicable Signup Flow
# ================================================
# This file stores environment variables needed for Firebase authentication and Firestore database.
# DO NOT commit this file to version control. It contains sensitive credentials.

# Firebase API Configuration
# Get these from your Firebase Console: https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# PayPal Configuration (Already configured in code)
# PAYPAL_CLIENT_ID=AZUMX5DxfcX4D8ehTfPRz939Ap79dAuOobQojsbeSv6LKTfkCcS_xoxLGHUv0SZum7OfOA1wKI6BGerr
# PAYPAL_PLAN_ID=P-17K32045868578318NHXU6LA

# ================================================
# SETUP INSTRUCTIONS
# ================================================
# 
# 1. Go to Firebase Console: https://console.firebase.google.com/
# 2. Select your Musicable project
# 3. Click "Project Settings" (gear icon)
# 4. Under "Your apps", find your web app
# 5. Copy the Firebase config values:
#    - apiKey → VITE_FIREBASE_API_KEY
#    - authDomain → VITE_FIREBASE_AUTH_DOMAIN
#    - projectId → VITE_FIREBASE_PROJECT_ID
#    - storageBucket → VITE_FIREBASE_STORAGE_BUCKET
#    - messagingSenderId → VITE_FIREBASE_MESSAGING_SENDER_ID
#    - appId → VITE_FIREBASE_APP_ID
#    - measurementId → VITE_FIREBASE_MEASUREMENT_ID
#
# 6. Paste your actual values into this file
# 7. Save and restart the dev server: npm run dev
#
# ================================================
# FIRESTORE SETUP
# ================================================
# 
# The following Firestore collection and indexes are required:
#
# Collection: "signups"
# Documents have the following structure:
# {
#   email: string,
#   goals: string[],
#   skillLevel: string,
#   topics: string[],
#   genres: string[],
#   subscriptionId: string (added after payment),
#   planType: string (added after payment),
#   status: string (default: "pending", updated to "active" after payment),
#   createdAt: timestamp,
#   updatedAt: timestamp
# }
#
# Note: Firestore collection will be created automatically on first write.
# No manual setup needed beyond Firebase project creation.
#
# ================================================
# SIGNUP FLOW
# ================================================
#
# The new email-first signup flow works as follows:
# 
# 1. User clicks "Start for Free" → navigates to /signup
# 2. EmailCollection component → email input & Firestore save
#    - Email validated and saved to "signups" collection
#    - Returns: email + docId (Firestore document ID)
#
# 3. Onboarding component → 4-step questionnaire
#    - Goals, Skill Level, Topics, Genres
#    - Updates "signups" document with onboarding data
#
# 4. TrialBilling component → Account creation + PayPal
#    - User enters password (optional for Firebase auth)
#    - Clicks PayPal button to start subscription
#    - On approval: saves subscriptionId and planType to Firestore
#    - Redirects to /dashboard
#
# ================================================
# TESTING LOCALLY
# ================================================
#
# 1. Start dev server:
#    npm run dev
#
# 2. Navigate to http://localhost:5173/signup
#
# 3. Follow the signup flow:
#    - Enter email
#    - Answer questionnaire
#    - Use PayPal sandbox for testing payments
#
# 4. Check Firestore Console to verify data saved:
#    - Go to https://console.firebase.google.com/
#    - Select your project → Firestore Database
#    - Check "signups" collection for saved records
#
# ================================================
# TROUBLESHOOTING
# ================================================
#
# Issue: "Firebase SDK not initialized"
# → Verify all VITE_FIREBASE_* variables are set correctly in .env.local
# → Restart dev server after changing .env.local
#
# Issue: "Firestore permission denied"
# → Check Firebase security rules at console.firebase.google.com
# → Rules should allow writes to "signups" collection for new emails
#
# Issue: "PayPal button not showing"
# → Verify PayPal script loads in browser DevTools (Network tab)
# → Check client ID is correct in TrialBilling.tsx
#
# Issue: "Email already exists" error
# → This is expected if user refreshes during signup
# → System returns existing docId instead of creating new one
#
# ================================================
